{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/funnels/:path*",
      "destination": "https://bigronjones-2ah1.onrender.com/api/funnels/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://bigronjones-2ah1.onrender.com/api/:path*"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
